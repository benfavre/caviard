# Dedicated PUBLIC client registered with the existing Inklura identity provider.
# Grants: urn:ietf:params:oauth:grant-type:device_code, refresh_token.
# Scopes: openid profile email offline_access. No client secret in Electron.
INKLURA_PDF_OIDC_CLIENT_ID=
INKLURA_PDF_API_URL=http://127.0.0.1:4387
INKLURA_PDF_PORT=4387
INKLURA_PDF_DATABASE=./data/inklura-pdf.sqlite
# Purchases remain off until pricing and live activation are explicitly approved.
INKLURA_PDF_PAYMENTS_ENABLED=false
INKLURA_PDF_ALLOW_LIVE_PAYMENTS=false
STRIPE_SECRET_KEY=
# Required for legacy keys; verified against modern key prefixes when present.
INKLURA_PDF_STRIPE_MODE=test
STRIPE_WEBHOOK_SECRET=
INKLURA_PDF_PRICE_VOLUME_100=
INKLURA_PDF_PRICE_VOLUME_500=
INKLURA_PDF_PRICE_VOLUME_1000=
INKLURA_PDF_PRICE_BUSINESS_20=
INKLURA_PDF_PRICE_BUSINESS_100=
INKLURA_PDF_PRICE_BUSINESS_500=

INKLURA_PDF_PORTAL_CONFIGURATION=
INKLURA_PDF_FRANCE_TAX_RATE=
# Apple purchases stay disabled until real sandbox acceptance and notification
# delivery have passed. Keys belong only on the server, never inside Electron.
INKLURA_APPLE_PURCHASES_ENABLED=false
INKLURA_APPLE_IAP_KEY_FILE=
INKLURA_APPLE_IAP_KEY_ID=
INKLURA_APPLE_ISSUER_ID=
# Dedicated synthetic test/reviewer ledger account IDs only; never customers.
INKLURA_APPLE_SANDBOX_ACCOUNTS=
