[Unit]
Description=Verify and back up Inklura PDF account database
After=inklura-pdf.service

[Service]
Type=oneshot
User=inklura-pdf
Group=inklura-pdf
EnvironmentFile=/etc/inklura-pdf.env
ExecStart=/usr/local/bin/node /opt/inklura-pdf/current/server/backup.mjs
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/inklura-pdf
